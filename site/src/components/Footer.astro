---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const today = new Date();
---

<footer>
	<div class="inner">
		<p class="brand">Poured<span>.</span></p>
		<p class="tag">Practical resin art guides. No fluff, no sponsored picks.</p>
		<nav>
			<a href={`${base}/blog/`}>All guides</a>
			<a href={`${base}/about/`}>About</a>
			<a href={`${base}/rss.xml`}>RSS</a>
		</nav>
		<p class="copy">&copy; {today.getFullYear()} Poured. All rights reserved.</p>
	</div>
</footer>
<style>
	footer {
		border-top: 2px solid var(--flint);
		padding: 2.5rem 0 3rem;
	}
	.inner {
		width: 1080px;
		max-width: calc(100% - 2.5rem);
		margin: 0 auto;
	}
	.brand {
		font-size: 1.3rem;
		font-weight: 700;
		margin: 0;
	}
	.brand span {
		color: var(--rust);
	}
	.tag {
		color: var(--flint-soft);
		margin: 0.3rem 0 1.2rem;
		font-size: 0.95rem;
	}
	nav {
		display: flex;
		gap: 1.4rem;
		margin-bottom: 1.5rem;
	}
	nav a {
		color: var(--flint);
		text-decoration: none;
		font-weight: 700;
		font-size: 0.85rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}
	nav a:hover {
		color: var(--rust);
	}
	.copy {
		color: var(--flint-soft);
		font-size: 0.85rem;
		margin: 0;
	}
</style>
