---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<header class="masthead">
	<nav>
		<a href={`${base}/`} class="brand">Poured<span>.</span></a>
		<div class="links">
			<a href={`${base}/blog/`}>Guides</a>
			<a href={`${base}/about/`}>About</a>
		</div>
	</nav>
</header>
<style>
	.masthead {
		border-bottom: 2px solid var(--flint);
		background: var(--paper);
	}
	nav {
		width: 1080px;
		max-width: calc(100% - 2.5rem);
		margin: 0 auto;
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		padding: 1.1rem 0;
	}
	.brand {
		font-size: 1.6rem;
		font-weight: 700;
		letter-spacing: -0.02em;
		color: var(--flint);
		text-decoration: none;
	}
	.brand span {
		color: var(--rust);
	}
	.links {
		display: flex;
		gap: 1.4rem;
	}
	.links a {
		color: var(--flint);
		text-decoration: none;
		font-weight: 700;
		font-size: 0.95rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}
	.links a:hover {
		color: var(--rust);
	}
</style>
